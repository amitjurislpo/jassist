# JurisAssistMe website: every environment variable. Copy to .env.local for local work.
# Secrets are never committed. On Vercel they are set per environment (Production / Preview).
# "Server only" variables are never sent to the browser.

# ---- Site ----
# Base URL for canonical tags, sitemap.xml, share tags and JSON-LD (no trailing slash). Leave unset to use
# https://www.jurisassistme.com (also on previews, which are never indexed). build.js reads SITE_URL first.
NEXT_PUBLIC_SITE_URL=
# Optional: the "last changed" date the sitemap gives pages that only change with a deployment (YYYY-MM-DD).
# Default: the day the server started.
BUILD_DATE=

# ---- Data (the group's AWS RDS PostgreSQL, private) ---- server only
# On Vercel the site reaches its database only through the data link: a Lambda inside the group VPC with an HTTPS
# address (infra/datalink/README.md). The database login is never on Vercel.
# The Lambda's function URL for this environment (terraform output alias_urls).
DATA_LINK_URL=
# 64 random hex characters, different per environment; the Lambda holds the same value.
DATA_LINK_SECRET=
# Local development and tests only: a direct database instead of the link.
DATABASE_URL=postgres://localhost/jassist_dev
# Optional, local only: pool size (default 3).
DATABASE_POOL_MAX=3
# Optional: set to "false" only if the RDS CA bundle is not trusted by Node (default: verify).
PG_SSL_REJECT_UNAUTHORIZED=true
# Local only: which environment a local migration run is for, and which one the link signs (Vercel sets VERCEL_ENV).
APP_ENV=development
# Local migration runs only (npm run db:migrate): a direct connection, never a pooler.
DIRECT_DATABASE_URL=postgres://localhost/jassist_dev
# Build only: how long a build waits for the data link to hold its migrations (default 900 seconds).
DATALINK_WAIT_SECONDS=900

# Lambda only (set by the release worker or scripts/datalink-config.sh from Doppler, never on Vercel):
#   DATABASE_URL          that environment's database login (Doppler key DATALINK_DATABASE_URL)
#   DATA_LINK_SECRET      the same signing secret as above
#   JASSIST_ENVIRONMENT   "production" or "preview"
#   IAMJCG_CONSUMER_CREDENTIAL  passed on to the site through the data link (lib/config/linked.ts)

# ---- Sanity ----
NEXT_PUBLIC_SANITY_PROJECT_ID=
# "production" for the live site, "preview" for preview deployments (keeps preview data apart).
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-02-19
# Server only. Viewer token. The datasets are private, so every read (public and review) uses it.
SANITY_API_READ_TOKEN=
# Server only. Editor token, used ONLY to send a rejected post back to its author and to delete.
SANITY_API_WRITE_TOKEN=
# Server only. Secret shared with the Sanity webhook (/api/sanity/revalidate).
SANITY_WEBHOOK_SECRET=
# One-time set-up only (npm run sanity:setup), never on Vercel: a token with the project's Administrator role.
SANITY_MANAGEMENT_TOKEN=

# ---- Admin sign-in: SITA + IamJCG ---- server only
SITA_URL=https://sita.jurisconsultants.in
# The exact return address listed for "juris_assist" in SITA_CONSOLES. On preview this is still the production
# address: production passes the sign-in on (see SITA_PREVIEW_RELAY_URL).
SITA_RETURN_URL=https://www.jurisassistme.com/auth/sita/return
IAMJCG_URL=https://iamjcg.jurisconsultants.in
# This site's application key in IamJCG and SITA.
IAMJCG_APPLICATION=juris_assist
# Signed by apps-1 through the release worker into Doppler juris_assist/prd. On Vercel it is NOT set: the release
# worker puts it in the data link, and the site reads it from there (lib/config/linked.ts). Local development only.
IAMJCG_CONSUMER_CREDENTIAL=
# 32+ random characters. Signs the admin session cookie. Different per environment.
SESSION_SECRET=
# Production only: the one preview return address production may pass a sign-in on to.
SITA_PREVIEW_RELAY_URL=https://preview.jurisassistme.com/auth/sita/return
# Preview only: "true" so preview sign-ins are relayed through production.
SITA_RELAY_THROUGH_PRODUCTION=false
